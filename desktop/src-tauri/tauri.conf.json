{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Canturía",
  "version": "0.2.2",
  "identifier": "org.borck.canturia",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Canturía",
        "width": 1100,
        "height": 820,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Words into a song — bring your own ACE-Step server",
    "longDescription": "Paste lyrics or describe a topic, choose a genre and a length, and get a song from your own ACE-Step server. No account, no telemetry; audio is saved locally.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
